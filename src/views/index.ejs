<%- include('partials/header') %>

<!-- Badge Estado Oficial -->
<div class="flex flex-wrap items-center justify-between gap-2 bg-slate-900/60 border border-slate-800 rounded-xl px-4 py-2.5 text-xs">
  <div class="flex items-center gap-2">
    <span class="relative flex h-2.5 w-2.5">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
      <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
    </span>
    <span class="text-slate-300 font-medium">Cotización Oficial Vigente Hoy</span>
  </div>
  <div class="text-slate-400 text-[11px] flex items-center gap-1.5">
    <span>🏛️ Superfinanciera de Colombia</span>
  </div>
</div>

<!-- TARJETA PRINCIPAL (HERO): TRM HOY -->
<div class="relative overflow-hidden rounded-3xl bg-gradient-to-b from-slate-900 via-slate-900/90 to-slate-950 border border-slate-800 p-6 md:p-8 shadow-2xl shadow-emerald-950/20">
  <!-- Efecto de resplandor sutil de fondo -->
  <div class="absolute -top-24 -right-24 w-64 h-64 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
    <div>
      <span class="text-xs uppercase font-extrabold tracking-wider text-emerald-400">TRM Oficial Colombia</span>
      <h1 class="text-xl md:text-2xl font-extrabold text-white">Precio del Dólar Hoy</h1>
      <p class="text-xs text-slate-400 mt-0.5"><%= trm.hoy.fechaTexto %></p>
    </div>

    <!-- Píldora de Variación -->
    <div>
      <% if (trm.hoy.tendencia === 'subio') { %>
        <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-red-500/10 text-red-400 border border-red-500/20 text-xs font-bold">
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 3a1 1 0 01.707.293l5 5a1 1 0 01-1.414 1.414L11 6.414V17a1 1 0 11-2 0V6.414L5.707 9.707a1 1 0 01-1.414-1.414l5-5A1 1 0 0110 3z" clip-rule="evenodd"/></svg>
          Subió <%= trm.hoy.diferenciaFormateada %> COP (<%= trm.hoy.porcentaje %>%)
        </div>
      <% } else if (trm.hoy.tendencia === 'bajo') { %>
        <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-xs font-bold">
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 17a1 1 0 01-.707-.293l-5-5a1 1 0 011.414-1.414L9 13.586V3a1 1 0 112 0v10.586l3.293-3.293a1 1 0 111.414 1.414l-5 5A1 1 0 0110 17z" clip-rule="evenodd"/></svg>
          Bajó <%= trm.hoy.diferenciaFormateada %> COP (<%= trm.hoy.porcentaje %>%)
        </div>
      <% } else { %>
        <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-800 text-slate-300 border border-slate-700 text-xs font-bold">
          <span>➖ Sin variación</span>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Cifra Gigante -->
  <div class="my-4">
    <div class="flex items-baseline gap-2">
      <span class="text-4xl sm:text-6xl font-black tracking-tight text-white font-mono">
        <%= trm.hoy.valorFormateado %>
      </span>
      <span class="text-lg font-bold text-slate-400">COP</span>
    </div>
    <div class="text-xs text-slate-400 mt-1">
      Equivalencia: 1 Dólar Estadounidense (USD) = <%= trm.hoy.valorFormateado %> Pesos Colombianos
    </div>
  </div>

<%
  const textoWhatsApp = 
    `🇨🇴 *DÓLAR EN COLOMBIA HOY*\n` +
    `💵 TRM Oficial: *${trm.hoy.valorFormateado} COP* (${trm.hoy.tendencia === 'subio' ? '▲ Subió' : '▼ Bajó'} ${trm.hoy.diferenciaFormateada} COP / ${trm.hoy.porcentaje}%)\n\n` +
    `📊 *Calcula tu cambio en vivo y mira la TRM de mañana:*\n` +
    `👉 https://dolar.appzplay.online\n\n` +
    `✈️ *Únete al canal de Telegram para recibir las alertas oficiales (8:00 AM y 4:30 PM):*\n` +
    `👉 ${typeof telegramUrl !== 'undefined' ? telegramUrl : 'https://t.me/+hLULrDoazSwzNWNh'}`;
%>

  <!-- Botones de Acción Inmediata (Compartir y Telegram) -->
  <div class="pt-4 border-t border-slate-800/80 flex flex-wrap items-center gap-3">
    <!-- Compartir WhatsApp (Texto enriquecido + Invitación a Telegram) -->
    <a href="https://api.whatsapp.com/send?text=<%= encodeURIComponent(textoWhatsApp) %>" 
       target="_blank" rel="noopener noreferrer"
       class="flex-1 min-w-[170px] flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs shadow-lg shadow-emerald-600/30 active:scale-95 transition-all">
      <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M17.472 14.382c-.301-.15-1.78-.878-2.056-.979-.276-.1-.477-.15-.678.15-.201.3-.778.979-.954 1.18-.176.2-.351.226-.653.076-.301-.15-1.272-.469-2.423-1.496-.897-.798-1.503-1.784-1.679-2.086-.176-.301-.019-.464.132-.614.135-.135.301-.351.452-.527.15-.176.2-.301.301-.502.1-.2.05-.376-.025-.527-.075-.15-.678-1.632-.929-2.235-.245-.588-.493-.508-.678-.517l-.577-.01c-.2 0-.527.075-.803.376s-1.054 1.03-1.054 2.511c0 1.481 1.079 2.909 1.23 3.11 0.15 0.201 2.124 3.243 5.145 4.549 0.719 0.311 1.28 0.497 1.719 0.636 0.722 0.23 1.378 0.197 1.897 0.12 0.58-.087 1.78-.727 2.03-1.43 0.25-.704 0.25-1.306 0.176-1.43-.075-.126-.276-.201-.577-.352zM12 2C6.477 2 2 6.477 2 12c0 1.891.523 3.662 1.433 5.178L2 22l4.981-1.308C8.423 21.536 10.155 22 12 22c5.523 0 10-4.477 10-12S17.523 2 12 2z"/></svg>
      Compartir en WhatsApp
    </a>

    <!-- Generar Imagen para Estado de WhatsApp -->
    <button id="btnShareStory" 
       class="flex-1 min-w-[170px] flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400 text-white font-bold text-xs shadow-lg shadow-orange-500/20 active:scale-95 transition-all">
      <svg class="w-4 h-4 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="4"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
      <span>📸 Imagen para Estado</span>
    </button>

    <!-- Alertas Telegram -->
    <a href="<%= typeof telegramUrl !== 'undefined' ? telegramUrl : 'https://t.me/+hLULrDoazSwzNWNh' %>" 
       target="_blank" rel="noopener noreferrer"
       class="flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-slate-800 hover:bg-slate-700 text-sky-400 border border-slate-700 font-bold text-xs active:scale-95 transition-all">
      <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.894 8.221l-1.97 9.28c-.145.658-.537.818-1.084.508l-3-2.21-1.446 1.394c-.16.16-.295.295-.605.295l.213-3.053 5.56-5.023c.242-.213-.054-.333-.373-.12l-6.871 4.326-2.962-.924c-.643-.204-.657-.643.136-.953l11.57-4.461c.537-.197 1.006.128.832.941z"/></svg>
      Canal Telegram
    </a>
  </div>
</div>

<!-- TARJETA: TRM DE MAÑANA (EL GOLPE VIRAL) -->
<% if (trm.manana && trm.manana.publicada) { %>
  <div class="rounded-2xl bg-gradient-to-r from-sky-950/60 to-indigo-950/60 border border-sky-800/80 p-5 shadow-lg">
    <div class="flex items-center gap-2 text-sky-400 text-xs font-extrabold uppercase tracking-wider mb-2">
      <span class="inline-block w-2 h-2 rounded-full bg-sky-400 animate-pulse"></span>
      Oficial: TRM Confirmada para Mañana
    </div>
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div>
        <div class="text-3xl font-extrabold text-white font-mono"><%= trm.manana.valorFormateado %> COP</div>
        <p class="text-xs text-slate-300 mt-0.5">Vigente a partir de: <b><%= trm.manana.fechaTexto %></b></p>
      </div>
      <div>
        <% if (trm.manana.tendencia === 'subio') { %>
          <span class="px-3 py-1.5 rounded-xl bg-red-500/20 text-red-300 border border-red-500/30 text-xs font-bold inline-flex items-center gap-1">
            ▲ Sube <%= trm.manana.diferenciaFormateada %> COP (<%= trm.manana.porcentaje %>%)
          </span>
        <% } else if (trm.manana.tendencia === 'bajo') { %>
          <span class="px-3 py-1.5 rounded-xl bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 text-xs font-bold inline-flex items-center gap-1">
            ▼ Baja <%= trm.manana.diferenciaFormateada %> COP (<%= trm.manana.porcentaje %>%)
          </span>
        <% } else { %>
          <span class="px-3 py-1.5 rounded-xl bg-slate-800 text-slate-300 text-xs font-bold">Sin cambios</span>
        <% } %>
      </div>
    </div>
  </div>
<% } else { %>
  <div class="rounded-2xl bg-slate-900/50 border border-slate-800/80 p-4 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-lg bg-amber-500/10 text-amber-400 flex items-center justify-center font-bold text-sm shrink-0">
        ⏰
      </div>
      <div>
        <p class="font-bold text-slate-200">¿En cuánto quedará el dólar mañana?</p>
        <p class="text-slate-400 text-[11px]">La Superfinanciera publica la tasa oficial de mañana de lunes a viernes a las <b>4:30 PM</b>.</p>
      </div>
    </div>
    <a href="<%= typeof telegramUrl !== 'undefined' ? telegramUrl : 'https://t.me/+hLULrDoazSwzNWNh' %>" target="_blank" rel="noopener noreferrer" 
       class="shrink-0 px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-sky-400 border border-slate-700 font-semibold text-[11px] flex items-center gap-1.5 transition-colors">
      <span>Activar aviso</span>
    </a>
  </div>
<% } %>

<!-- BANNER ADSENSE SUPERIOR -->
<%- include('partials/ad-slot') %>

<!-- CALCULADORA INTERACTIVA DE CONVERSIÓN -->
<div class="rounded-3xl bg-slate-900 border border-slate-800 p-6 shadow-xl">
  <div class="flex items-center justify-between mb-4">
    <div>
      <h2 class="text-base sm:text-lg font-bold text-white flex items-center gap-2">
        <span>🧮</span> Calculadora Dólar a Pesos Colombianos
      </h2>
      <p class="text-xs text-slate-400">Conversión en vivo con la TRM oficial de hoy (<%= trm.hoy.valorFormateado %>)</p>
    </div>
    <button id="btnSwitch" class="p-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white transition-all text-xs flex items-center gap-1 border border-slate-700" title="Invertir divisas">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"/></svg>
      <span class="hidden sm:inline">Invertir</span>
    </button>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <!-- Input 1 -->
    <div class="bg-slate-950 p-4 rounded-2xl border border-slate-800 focus-within:border-emerald-500 transition-colors">
      <label id="labelFrom" class="block text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-1">
        Dólares Estadounidenses (USD)
      </label>
      <div class="flex items-center gap-2">
        <span id="symFrom" class="text-lg font-bold text-slate-500">$</span>
        <input id="inputFrom" type="number" step="any" value="100" class="w-full bg-transparent text-2xl font-black text-white outline-none font-mono placeholder:text-slate-700">
      </div>
    </div>

    <!-- Input 2 (Resultado) -->
    <div class="bg-slate-950 p-4 rounded-2xl border border-slate-800 focus-within:border-emerald-500 transition-colors">
      <label id="labelTo" class="block text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-1">
        Pesos Colombianos (COP)
      </label>
      <div class="flex items-center gap-2">
        <span id="symTo" class="text-lg font-bold text-slate-500">$</span>
        <input id="inputTo" type="text" readonly class="w-full bg-transparent text-2xl font-black text-emerald-400 outline-none font-mono">
      </div>
    </div>
  </div>

  <!-- Atajos Rápidos -->
  <div class="mt-4 flex flex-wrap items-center gap-2 text-xs">
    <span class="text-slate-500 text-[11px] font-semibold mr-1">Cantidades rápidas:</span>
    <button class="btnQuick px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 transition-colors" data-amount="10">$10</button>
    <button class="btnQuick px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 transition-colors" data-amount="50">$50</button>
    <button class="btnQuick px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-emerald-400 font-bold border border-emerald-500/30 transition-colors" data-amount="100">$100</button>
    <button class="btnQuick px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 transition-colors" data-amount="500">$500</button>
    <button class="btnQuick px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 transition-colors" data-amount="1000">$1.000</button>
  </div>
</div>

<!-- OTRAS DIVISAS E INDICADORES CLAVE -->
<div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
  <!-- Euro -->
  <div class="p-4 rounded-2xl bg-slate-900 border border-slate-800">
    <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Euro Oficial</div>
    <div class="text-lg font-black text-white font-mono mt-1"><%= extras.euro.formateado %></div>
    <div class="text-[10px] text-slate-500 mt-0.5">COP por 1 EUR</div>
  </div>

  <!-- Dólar Cripto USDT -->
  <div class="p-4 rounded-2xl bg-slate-900 border border-slate-800">
    <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Dólar USDT (Cripto)</div>
    <div class="text-lg font-black text-emerald-400 font-mono mt-1"><%= extras.usdt.formateado %></div>
    <div class="text-[10px] text-slate-500 mt-0.5">Paridad digital</div>
  </div>

  <!-- Casas de Cambio Compra/Venta -->
  <div class="p-4 rounded-2xl bg-slate-900 border border-slate-800">
    <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Casas de Cambio</div>
    <div class="text-xs font-bold text-slate-300 mt-1">
      C: <span class="text-white font-mono"><%= extras.casasCambio.compraFormateado %></span>
    </div>
    <div class="text-xs font-bold text-slate-300">
      V: <span class="text-white font-mono"><%= extras.casasCambio.ventaFormateado %></span>
    </div>
  </div>

  <!-- Salario Mínimo en USD -->
  <div class="p-4 rounded-2xl bg-slate-900 border border-slate-800">
    <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400">SMLV Colombia</div>
    <div class="text-lg font-black text-sky-400 font-mono mt-1">$ <%= extras.salarioMinimo.usd %> USD</div>
    <div class="text-[10px] text-slate-500 mt-0.5"><%= extras.salarioMinimo.copFormateado %> COP</div>
  </div>
</div>

<!-- GRÁFICA HISTÓRICA (ÚLTIMOS 30 DÍAS) -->
<div class="rounded-3xl bg-slate-900 border border-slate-800 p-6 shadow-xl">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
    <div>
      <h3 class="text-base font-bold text-white">Comportamiento del Dólar (Últimos 30 días)</h3>
      <p class="text-xs text-slate-400">Tendencia histórica de la TRM oficial certificada</p>
    </div>
    <div class="flex items-center gap-3 text-xs">
      <div class="text-slate-400">Mín: <span class="text-white font-bold font-mono"><%= trm.estadisticas.minimo30Formateado %></span></div>
      <div class="text-slate-400">Máx: <span class="text-white font-bold font-mono"><%= trm.estadisticas.maximo30Formateado %></span></div>
    </div>
  </div>

  <!-- Contenedor del Canvas -->
  <div class="relative w-full h-64">
    <canvas id="chartTRM"></canvas>
  </div>
</div>

<!-- BANNER ADSENSE MEDIO -->
<%- include('partials/ad-slot') %>

<!-- TABLA HISTÓRICA RESUMIDA -->
<div class="rounded-3xl bg-slate-900 border border-slate-800 overflow-hidden shadow-xl">
  <div class="p-5 border-b border-slate-800 flex items-center justify-between">
    <div>
      <h3 class="text-base font-bold text-white">Histórico Reciente de la TRM</h3>
      <p class="text-xs text-slate-400">Últimos días cotizados en Colombia</p>
    </div>
    <a href="/historico" class="text-xs font-bold text-emerald-400 hover:text-emerald-300 transition-colors flex items-center gap-1">
      Ver tabla completa &rarr;
    </a>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-left text-xs">
      <thead class="bg-slate-950 text-slate-400 uppercase tracking-wider font-semibold border-b border-slate-800">
        <tr>
          <th class="p-3.5 pl-5">Fecha</th>
          <th class="p-3.5">TRM Oficial</th>
          <th class="p-3.5">Variación</th>
          <th class="p-3.5 pr-5 text-right">Porcentaje</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-800/60 font-mono">
        <% trm.historicoTabla.slice(0, 7).forEach(function(row) { %>
          <tr class="hover:bg-slate-800/30 transition-colors">
            <td class="p-3.5 pl-5 text-slate-300 font-sans font-medium"><%= row.fecha %></td>
            <td class="p-3.5 text-white font-bold"><%= row.valorFormateado %></td>
            <td class="p-3.5">
              <% if (row.tendencia === 'subio') { %>
                <span class="text-red-400 font-semibold"><%= row.diferencia %></span>
              <% } else if (row.tendencia === 'bajo') { %>
                <span class="text-emerald-400 font-semibold"><%= row.diferencia %></span>
              <% } else { %>
                <span class="text-slate-500 font-semibold">$ 0,00</span>
              <% } %>
            </td>
            <td class="p-3.5 pr-5 text-right">
              <% if (row.tendencia === 'subio') { %>
                <span class="px-2 py-0.5 rounded bg-red-500/10 text-red-400 text-[11px] font-bold"><%= row.porcentaje %></span>
              <% } else if (row.tendencia === 'bajo') { %>
                <span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 text-[11px] font-bold"><%= row.porcentaje %></span>
              <% } else { %>
                <span class="px-2 py-0.5 rounded bg-slate-800 text-slate-400 text-[11px]">0.00%</span>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<!-- SECCIÓN EDITORIAL EDUCATIVA (BLINDAJE Y VALOR PARA ADSENSE & SEO) -->
<article class="rounded-3xl bg-slate-900 border border-slate-800 p-6 md:p-8 space-y-6 text-slate-300 text-xs sm:text-sm leading-relaxed">
  <div class="border-b border-slate-800 pb-4">
    <h2 class="text-lg sm:text-xl font-extrabold text-white">Guía Financiera: El Dólar y la TRM en Colombia</h2>
    <p class="text-xs text-slate-400 mt-1">Todo lo que necesitas entender sobre el tipo de cambio oficial, su cálculo y su impacto.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="space-y-2">
      <h3 class="font-bold text-white text-sm flex items-center gap-1.5">
        <span class="text-emerald-400">1.</span> ¿Qué es la TRM y quién la certifica?
      </h3>
      <p class="text-slate-400 leading-normal">
        La <b>Tasa Representativa del Mercado (TRM)</b> es el indicador oficial de la tasa de cambio en Colombia. Expresa la cantidad de pesos colombianos (COP) requeridos para comprar un dólar estadounidense (USD). En Colombia es calculada y certificada diariamente por la <b>Superintendencia Financiera de Colombia</b> con base en las operaciones de compra y venta de divisas negociadas entre intermediarios financieros.
      </p>
    </div>

    <div class="space-y-2">
      <h3 class="font-bold text-white text-sm flex items-center gap-1.5">
        <span class="text-emerald-400">2.</span> ¿A qué hora se conoce la TRM del día siguiente?
      </h3>
      <p class="text-slate-400 leading-normal">
        El mercado cambiario interbancario opera de lunes a viernes entre las 8:00 AM y la 1:00 PM. Posteriormente, la Superintendencia Financiera consolida el volumen total transado y emite la certificación oficial aproximadamente a las <b>4:30 PM</b>. Dicha tasa rige para el día hábil siguiente (y durante fines de semana y festivos).
      </p>
    </div>

    <div class="space-y-2">
      <h3 class="font-bold text-white text-sm flex items-center gap-1.5">
        <span class="text-emerald-400">3.</span> ¿Por qué en las casas de cambio el precio es diferente?
      </h3>
      <p class="text-slate-400 leading-normal">
        La TRM aplica para operaciones electrónicas bancarias, comercio exterior y pagos con tarjeta de crédito. Las <b>casas de cambio físicas</b> operan en el mercado minorista de efectivo; sus precios dependen de la oferta y demanda de billetes físicos en cada ciudad y suelen tener un margen de compra inferior y de venta cercano a la TRM.
      </p>
    </div>

    <div class="space-y-2">
      <h3 class="font-bold text-white text-sm flex items-center gap-1.5">
        <span class="text-emerald-400">4.</span> ¿Cómo te afecta la variación del dólar?
      </h3>
      <p class="text-slate-400 leading-normal">
        Cuando el dólar sube en Colombia, se encarecen los productos importados (tecnología, insumos agropecuarios, vehículos) y los viajes al exterior, pero se benefician quienes reciben remesas o exportan bienes. Cuando el dólar baja, se alivia la presión inflacionaria sobre los bienes de consumo foráneo.
      </p>
    </div>
  </div>
</article>

