<%- include('partials/header') %>

<div class="space-y-6">
  <!-- Cabecera -->
  <div class="rounded-3xl bg-slate-900 border border-slate-800 p-6 md:p-8">
    <div class="text-xs uppercase font-extrabold tracking-wider text-emerald-400 mb-1">Registro Oficial de Colombia</div>
    <h1 class="text-2xl sm:text-3xl font-extrabold text-white">Histórico de la TRM del Dólar</h1>
    <p class="text-xs sm:text-sm text-slate-400 mt-1">
      Consulta los valores oficiales de la Tasa Representativa del Mercado de los últimos 30 días calendario certificados por la Superintendencia Financiera.
    </p>

    <!-- Resumen Estadístico 30 Días -->
    <div class="grid grid-cols-3 gap-3 mt-6 pt-6 border-t border-slate-800/80">
      <div class="p-3 rounded-xl bg-slate-950/60 border border-slate-800">
        <div class="text-[10px] uppercase font-bold text-slate-500">Mínimo 30 días</div>
        <div class="text-sm sm:text-base font-extrabold text-white font-mono mt-0.5"><%= trm.estadisticas.minimo30Formateado %></div>
      </div>
      <div class="p-3 rounded-xl bg-slate-950/60 border border-slate-800">
        <div class="text-[10px] uppercase font-bold text-slate-500">Promedio 30 días</div>
        <div class="text-sm sm:text-base font-extrabold text-emerald-400 font-mono mt-0.5"><%= trm.estadisticas.promedio30Formateado %></div>
      </div>
      <div class="p-3 rounded-xl bg-slate-950/60 border border-slate-800">
        <div class="text-[10px] uppercase font-bold text-slate-500">Máximo 30 días</div>
        <div class="text-sm sm:text-base font-extrabold text-white font-mono mt-0.5"><%= trm.estadisticas.maximo30Formateado %></div>
      </div>
    </div>
  </div>

  <!-- BANNER ADSENSE -->
  <%- include('partials/ad-slot') %>

  <!-- Tabla Histórica Completa -->
  <div class="rounded-3xl bg-slate-900 border border-slate-800 overflow-hidden shadow-xl">
    <div class="p-5 border-b border-slate-800 flex items-center justify-between">
      <h2 class="text-base font-bold text-white">Tabla Cronológica Detallada</h2>
      <span class="text-xs text-slate-400">30 Registros</span>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="bg-slate-950 text-slate-400 uppercase tracking-wider font-semibold border-b border-slate-800">
          <tr>
            <th class="p-3.5 pl-5">Fecha Vigencia</th>
            <th class="p-3.5">Valor TRM</th>
            <th class="p-3.5">Variación Diaria</th>
            <th class="p-3.5 pr-5 text-right">Porcentaje</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800/60 font-mono">
          <% trm.historicoTabla.forEach(function(row) { %>
            <tr class="hover:bg-slate-800/30 transition-colors">
              <td class="p-3.5 pl-5 text-slate-300 font-sans font-medium"><%= row.fecha %></td>
              <td class="p-3.5 text-white font-bold"><%= row.valorFormateado %></td>
              <td class="p-3.5">
                <% if (row.tendencia === 'subio') { %>
                  <span class="text-red-400 font-semibold"><%= row.diferencia %></span>
                <% } else if (row.tendencia === 'bajo') { %>
                  <span class="text-emerald-400 font-semibold"><%= row.diferencia %></span>
                <% } else { %>
                  <span class="text-slate-500 font-semibold">$ 0,00</span>
                <% } %>
              </td>
              <td class="p-3.5 pr-5 text-right">
                <% if (row.tendencia === 'subio') { %>
                  <span class="px-2 py-0.5 rounded bg-red-500/10 text-red-400 text-[11px] font-bold"><%= row.porcentaje %></span>
                <% } else if (row.tendencia === 'bajo') { %>
                  <span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 text-[11px] font-bold"><%= row.porcentaje %></span>
                <% } else { %>
                  <span class="px-2 py-0.5 rounded bg-slate-800 text-slate-400 text-[11px]">0.00%</span>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
